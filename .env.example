# Значение cookie `refresh_token` с итд.com (DevTools → Application → Cookies → https://xn--d1ah4a.com).
# Нужен только для первого запуска: дальше библиотека сама хранит обновлённый токен в ITD_SESSION_FILE.
ITD_REFRESH_TOKEN=

# Файл, куда сохраняется актуальный refresh_token и device id (токен ротируется при каждом refresh).
ITD_SESSION_FILE=.itd-session.json
